# Copiez ce fichier en .env (même dossier) puis collez-y vos clés.
# Le fichier .env est ignoré par git et ne doit JAMAIS être copié dans le projet Godot.

# Google AI Studio (Gemini et Gemma) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq : https://console.groq.com/keys
GROQ_API_KEY=

# Mistral, offre gratuite « Experiment » : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Kafka (voir docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:9092

# PostgreSQL, mémoire des agents (voir docker-compose.yml ; port 5433, n'écoute que sur 127.0.0.1).
# Facultatif : sans ces lignes, le mot de passe est « guichet ». S'il change, changez les deux lignes, puis
# recréez la base (docker compose down -v efface les souvenirs conservés).
# 127.0.0.1 et non localhost : sous Windows, localhost peut faire attendre la connexion plus d'une minute.
POSTGRES_PASSWORD=guichet
POSTGRES_URL=postgresql://guichet:guichet@127.0.0.1:5433/guichet

# Exécutable Godot ouvert par lancer.ps1 (si absent, lancer.ps1 essaie l'emplacement ci-dessous)
GODOT_EXE=C:\Users\LEGION\Desktop\EIGSI 5A\Godot_v4.7.2-stable_win64.exe\Godot_v4.7.2-stable_win64.exe
